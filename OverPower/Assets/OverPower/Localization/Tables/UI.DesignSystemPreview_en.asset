  - m_Id: 191583192023040
    m_Localized: 04  /  INLINE ICONS & RICH TEXT
    m_Metadata:
      m_Items: []
  - m_Id: 191583204605952
    m_Localized: A clean inline syntax
    m_Metadata:
      m_Items: []
  - m_Id: 191583221383168
    m_Localized: Authors write {health} or {mana}. Rendering converts tokens to high-fidelity
      icons.
    m_Metadata:
      m_Items: []
  - m_Id: 191583242354688
    m_Localized: 'Baseline:  {attack}  {health}  {gold}  {mana}'
    m_Metadata:
      m_Items: []
  - m_Id: 191583292686336
    m_Localized: Fireball & Healing
    m_Metadata:
      m_Items: []
  - m_Id: 191583309463552
    m_Localized: Heal 20 {health} to the targeted unit.
    m_Metadata:
      m_Items: []
  - m_Id: 191583355600896
    m_Localized: Gain 2 {mana}.
    m_Metadata:
      m_Items: []
  - m_Id: 191583363989504
    m_Localized: Costs 3 {gold}.
    m_Metadata:
      m_Items: []
  - m_Id: 191583376572416
    m_Localized: This unit gains 5 {attack}.
    m_Metadata:
