DotNet/OverPower.Application/bin/
DotNet/OverPower.Application.Tests/bin/
DotNet/OverPower.Domain/bin/
DotNet/OverPower.Domain.Tests/bin/
DotNet/OverPower.Infrastructure/bin/
DotNet/OverPower.Infrastructure.Tests/bin/

# Third-party tools
OverPower/Assets/HeroEditor4D/
OverPower/Assets/DamageNumbersPro/
OverPower/Assets/Plugins/AllIn1SpriteShader/
OverPower/Assets/Hovl Studio/
OverPower/Assets/JMO Assets/
OverPower/Assets/Plugins/Demigiant/
OverPower/Assets/HealthBar/

# Asset server cache
[Aa]ssetStoreTools*

# Gradle cache directory
.gradle/

# Autogenerated VS/Rider/MonoDevelop solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.tlog
*.dll
*.exe

# Unity 3D Generated File On Crash Reports
sysinfo.txt

# Target builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables (ignore cached/built addressable assets)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/[Ii]nitial[Dd]ata/
/[Aa]ssets/StreamingAssets/aa/
OverPower/Assets/AddressableAssetsData/link.xml*
OverPower/Assets/AddressableAssetsData/Windows/
OverPower/Assets/AddressableAssetsData/Windows.meta
OverPower/Assets/AddressableAssetsData/ProfileDataSourceSettings.asset*

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE directories and user-specific settings
.idea/
.vscode/
.vs/
*.sln.DotSettings.user

# Backup and temporary files
*~
~*
# Avoid committing accidental local backups or caches
.recommenders/
