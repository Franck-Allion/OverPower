# =========================================================================
# Git LFS Configuration (Large Binary Assets)
# =========================================================================

# Image formats (Source art files)
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text

# Audio formats
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# 3D assets & animations
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text

# Video formats
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# Archives
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text

# =========================================================================
# Unity-Specific Text Merging / Diff Rules
# =========================================================================

# Ensure text files use LF line endings where appropriate (Unity prefers mixed or auto, but standardizing on LF is good for multiplatform)
# Actually, let's keep auto to avoid breaking Unity's native serialization on Windows.
* text=auto

# Explicitly declare native text file types to prevent corruption
*.cs text diff=csharp
*.cginc text
*.shader text
*.json text
*.xml text
*.yaml text
*.md text

# Force Unity YAML assets to use the standard text attributes so they are merged as text
*.unity text
*.prefab text
*.asset text
*.meta text
*.controller text
*.anim text
*.spriteatlas text
*.physicMaterial text
*.physicsMaterial2D text
*.guiskin text
*.fontsettings text
*.gxt text
